{
	"name": "DF_EnrichOrders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Sql_Orders",
						"type": "DatasetReference"
					},
					"name": "AllOrders"
				},
				{
					"dataset": {
						"referenceName": "Ds_blobproducts",
						"type": "DatasetReference"
					},
					"name": "AllProducts"
				},
				{
					"dataset": {
						"referenceName": "Ds_blobcustomer",
						"type": "DatasetReference"
					},
					"name": "AllCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_Sql_Customer",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "WithPr"
				},
				{
					"name": "WithCustomer"
				},
				{
					"name": "Columns"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          CustomerName as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          OrderMonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          DiscountPct as decimal(5,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostOfGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          IsDelivered as boolean,",
				"          Region as string,",
				"          LoadedAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> AllOrders",
				"source(output(",
				"          ProductId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          SubCategory as string,",
				"          Brand as string,",
				"          UnitPrice as string,",
				"          CostPrice as integer,",
				"          StockQty as string,",
				"          Supplier as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> AllProducts",
				"source(output(",
				"          CustomerId as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Phone as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> AllCustomers",
				"AllOrders, AllProducts join(AllOrders@ProductId == AllProducts@ProductId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> WithPr",
				"WithPr, AllCustomers join(AllOrders@CustomerId == AllCustomers@CustomerId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> WithCustomer",
				"WithCustomer derive(CostOfGoods = Quantity*CostPrice,",
				"          GrossProfit = NetRevenue-(Quantity*CostPrice),",
				"          ProfitMarginPct = (NetRevenue - Quantity*CostPrice)/100) ~> Columns",
				"Columns select(mapColumn(",
				"          OrderId,",
				"          CustomerId = AllCustomers@CustomerId,",
				"          ProductId = AllProducts@ProductId,",
				"          CustomerName = FirstName,",
				"          ProductName = AllProducts@ProductName,",
				"          Category = AllProducts@ProductName,",
				"          OrderDate,",
				"          OrderMonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice = AllOrders@UnitPrice,",
				"          DiscountPct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          NetRevenue,",
				"          CostOfGoods,",
				"          GrossProfit,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          IsDelivered,",
				"          Region,",
				"          LoadedAt,",
				"          ProductId = AllProducts@ProductId,",
				"          ProductName = AllProducts@ProductName,",
				"          Category = AllProducts@Category,",
				"          SubCategory,",
				"          Brand,",
				"          UnitPrice = AllProducts@UnitPrice,",
				"          CostPrice,",
				"          StockQty,",
				"          Supplier,",
				"          IsActive,",
				"          CustomerId = AllCustomers@CustomerId,",
				"          FirstName,",
				"          LastName,",
				"          Email,",
				"          Phone,",
				"          City,",
				"          State,",
				"          Country,",
				"          CustomerSegment,",
				"          JoinDate,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CustomerId as string,",
				"          FullName as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as date,",
				"          LoadedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}